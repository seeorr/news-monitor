{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "news-monitor-clock",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-10",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["3,13,23,33,43,53 * * * *"] },
  "observability": { "enabled": true },
  "vars": {
    "ENABLED": "false",
    "GITHUB_OWNER": "seeorr",
    "GITHUB_REPO": "news-monitor",
    "GITHUB_WORKFLOW": "monitor.yml",
    "GITHUB_REF": "main",
    "STRATEGY": "fast-only",
    "MONITOR_MODE": "capture-only"
  }
}
