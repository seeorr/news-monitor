{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "news-monitor-clock",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-10",
  "workers_dev": false,
  "preview_urls": false,
  // El segundo trigger lanza el vigilante (salud.yml) a los :51. Workers Free admite 5.
  "triggers": { "crons": ["3,13,23,33,43,53 * * * *", "51 * * * *"] },
  "observability": { "enabled": true },
  // ENABLED describe el estado QUERIDO del reloj, y en produccion el reloj esta
  // encendido. Estuvo en "false" como supuesta red de seguridad, y era justo lo
  // contrario: un "wrangler deploy" sin --var ENABLED:true APAGABA en silencio un
  // reloj que estaba corriendo. Una parada silenciosa es peor que un arranque
  // silencioso, porque se parece exactamente a que no hay noticias que contar.
  //
  // Si alguna vez hace falta desplegar SIN activar, se pasa --var ENABLED:false
  // a mano: que la excepcion cueste escribirla y la norma no.
  "vars": {
    "ENABLED": "true",
    "GITHUB_OWNER": "seeorr",
    "GITHUB_REPO": "news-monitor",
    "GITHUB_WORKFLOW": "monitor.yml",
    "GITHUB_HEALTH_WORKFLOW": "salud.yml",
    "GITHUB_REF": "main",
    "STRATEGY": "mixed"
  }
}
