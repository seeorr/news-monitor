{
  "name": "news-monitor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Market Intelligence personal: filtra, prioriza, contextualiza y explica.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "agenda": "tsx src/agenda.ts",
    "regimen": "tsx src/regimen.ts",
    "brief": "tsx src/brief.ts",
    "audit:filters": "tsx scripts/auditar-filtros.ts",
    "audit:queue": "tsx scripts/auditar-cola.ts",
    "audit:cadence": "tsx scripts/auditar-cadencia.ts",
    "audit:health": "tsx scripts/auditar-salud.ts",
    "verify:cadence:postgres": "tsx scripts/verificar-cadencia-postgres.ts",
    "verify:feeds": "tsx scripts/verificar-fuentes.ts",
    "verify:llm": "tsx scripts/verificar-llm.ts",
    "verify:queue:postgres": "tsx scripts/verificar-cola-postgres.ts",
    "verify:control:postgres": "tsx scripts/verificar-control-postgres.ts",
    "evaluate:news": "tsx scripts/evaluar-noticias.ts",
    "audit:news": "tsx scripts/auditar-noticias.ts",
    "dashboard": "next dev",
    "dashboard:build": "next build",
    "watchlist": "tsx src/watchlist.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test",
    "db:migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@neondatabase/serverless": "^1.1.0",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.9.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  }
