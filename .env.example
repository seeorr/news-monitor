# News Monitor — copia este archivo a `.env` y rellena los valores.
# `.env` esta en .gitignore y NUNCA se commitea: el repositorio es publico.
# En produccion estas mismas variables van a GitHub Secrets.

# --- LLM -------------------------------------------------------------------
# Gratis por defecto. Basta GROQ_API_KEY; OpenRouter es respaldo opcional.
# Mantener Groq en plan Free, sin tarjeta ni Developer. Guía: docs/llm-gratuitos.md
LLM_PROVIDERS=groq,openrouter
# https://console.groq.com/keys
GROQ_API_KEY=
# https://openrouter.ai/settings/keys (sin comprar créditos)
OPENROUTER_API_KEY=
GROQ_MODEL_SCORING=openai/gpt-oss-120b
GROQ_MODEL_ANALYSIS=openai/gpt-oss-120b
OPENROUTER_MODEL=openrouter/free
# Solo se usa con LLM_PROVIDERS=anthropic, nunca como respaldo automático.
# La API requiere saldo aparte de la suscripción de Claude.
ANTHROPIC_API_KEY=

# --- Macro (columna vertebral del sistema) ---------------------------------
# Gratis e inmediata: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# --- Notificaciones --------------------------------------------------------
# Habla con @BotFather en Telegram -> /newbot -> te da el token.
TELEGRAM_BOT_TOKEN=
# Escribe algo a tu bot y abre:
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# El numero de `chat.id` de tu mensaje es este valor.
TELEGRAM_CHAT_ID=

# Grupo OPCIONAL para compartir noticias con otras personas. Sin esta variable
# nada cambia: no hay segundo destino y el sistema se comporta como siempre.
# Es un id NEGATIVO (p. ej. -1001234567890), no un @nombre: se saca metiendo el
# bot en el grupo, escribiendo algo alli y abriendo el mismo /getUpdates.
#
# AVISO: el grupo recibe EXACTAMENTE lo mismo que el chat privado, sin filtrar.
# Eso incluye los movimientos de precio y los documentos ante la SEC de la
# watchlist, que solo existen porque esos valores estan vigilados. Quien lea el
# grupo puede deducir QUE empresas sigues; no puede deducir CUANTO tienes en
# cada una. Es una decision tomada a proposito, no un descuido.
TELEGRAM_GROUP_CHAT_ID=

# --- Base de datos: Neon Postgres ------------------------------------------
# Decidido: Neon, no Supabase. Ya esta en uso en Finance Hub, el free tier no
# caduca y el proyecto no se pausa mientras el cron lo toque.
# Panel de Neon -> Connection string (pooled). Tras rellenarla: npm run db:migrate
# Sin esto, en GitHub Actions cada ejecucion empieza en blanco y repite la alerta.
DATABASE_URL=

# --- Dashboard: clave de acceso --------------------------------------------
# La unica proteccion del dashboard, y tiene que estar puesta: sin ella la app
# NO se sirve (503 diciendo que falta), ni siquiera la pantalla de acceso. Es a
# proposito: la proteccion estandar de Vercel deja publico el dominio de
# produccion en el plan Hobby, y el dashboard enseña que empresas se vigilan,
# con que umbral y que se ha anunciado.
#
# Minimo 16 caracteres. Aqui NO va ningun valor, ni de ejemplo ni "cambiar
# esto": el repositorio es publico y una clave por defecto acaba probada contra
# el despliegue de verdad. Se genera una al azar y se guarda en el gestor de
# contraseñas. En local va en este .env; en Vercel, en Settings -> Environment
# Variables, marcada para Production, Preview y Development.
#
# El mismo valor firma la cookie de sesion, asi que cambiarlo cierra de golpe
# todas las sesiones abiertas. Es la unica forma de revocar una ya emitida.
DASHBOARD_PASSWORD=

# --- Mercado (bloque 3, opcionales: hay fallback gratuito) -----------------
ALPHA_VANTAGE_API_KEY=
COINGECKO_API_KEY=

# --- SEC EDGAR (tercera fuente) --------------------------------------------
# La SEC exige un contacto real en el User-Agent y responde 403 sin el.
# Formato: "Nombre Apellido correo@dominio". Sin esta variable el ciclo corre
# igual, pero sin documentos regulatorios: se dice por que y se sigue.
SEC_USER_AGENT=
# Tickers cuyos documentos se vigilan, separados por comas: AAPL,NVDA,MSFT
# Dato personal: dice en que inviertes. Nunca en el repositorio, que es publico.
SEC_WATCHLIST=
# Tipos de documento que interesan. Vacio = 8-K, 10-Q, 10-K, 6-K, 20-F y SC 13D.
EDGAR_FORMS=

# --- Filtro y techos del ciclo ---------------------------------------------
# Tickers de respaldo: añaden contexto, no convierten una mención en noticia.
# Tambien es dato personal.
WATCHLIST=
# Feeds que se leen (ids habilitados de FEEDS). Vacio = tandas seleccionadas:
#   fed-press, ecb-press, sec-press, cnbc-markets, yahoo-finance,
#   investing-economy, investing-indicators, investing-stocks
RSS_FEEDS=
RSS_FEED_BATCHES=core
# full | capture-only | process-only. capture-only persiste sin modelos ni Telegram.
MONITOR_MODE=full
SOURCE_CONCURRENCY=3
SOURCE_TIMEOUT_MS=45000
COLLECTION_TIMEOUT_MS=180000
EDGAR_MAX_FILINGS=1000
# Ventana de pendientes por rondas de editor. Caducidad: MAX_PENDING_HOURS.
QUEUE_SCAN_LIMIT=500
# Recupera solo trabajo de puntuacion abandonado, nunca entregas de Telegram.
PROCESSING_LEASE_MS=900000
# Un titular con mas de estas horas ya no es noticia. Solo aplica a noticias y
# documentos: un dato macro se fecha por su periodo, no por su publicacion.
MAX_ITEM_AGE_HOURS=72
# Techos por ciclo. El cron solicita una vuelta cada 30 minutos; puede fallar.
# Un feed puede soltar treinta
# elementos de golpe: sin techo, el primer dia se dispara la factura.
MAX_SCORING_PER_CYCLE=12
MAX_DEEP_PER_CYCLE=3

# --- Dos niveles de noticias (requiere migraciones locales antes de desplegar) ---
NEWS_DELIVERY_MODE=two-level
BRIEF_NEWS_THRESHOLD=5
WATCHLIST_IMPORTANT_THRESHOLD=6
# Cuotas de NOTICIAS, aunque varias viajen dentro de un solo mensaje.
BRIEF_NEWS_PER_HOUR=6
BRIEF_NEWS_PER_DAY=24
IMPORTANT_NEWS_PER_HOUR=3
IMPORTANT_NEWS_PER_DAY=12
BRIEF_BATCH_SIZE=3
BRIEF_INTERVAL_MINUTES=60
# Horas locales (fin exclusivo) en que los breves esperan sin gastar cupo. `none` lo apaga.
BRIEF_QUIET_HOURS=0-8
NEWS_TIMEZONE=Europe/Madrid
# Edad maxima de un breve CUANDO LE LLEGA EL TURNO, no al capturarlo. Con la cola
# a dos dias de retraso, lo que entro fresco salia de anteayer. No afecta a los
# importantes, que salen aunque lleguen tarde.
BRIEF_MAX_AGE_HOURS=12
MAX_PENDING_HOURS=48
# Incluye cada reintento. Cero impide nuevas peticiones de IA.
AI_CALLS_PER_DAY=120
# USD / millón de tokens. Vacío = coste desconocido, no gratis.
AI_SCORING_INPUT_USD_PER_MILLION=
AI_SCORING_OUTPUT_USD_PER_MILLION=
AI_ANALYSIS_INPUT_USD_PER_MILLION=
AI_ANALYSIS_OUTPUT_USD_PER_MILLION=

# --- Agenda macro y agrupacion ---------------------------------------------
# Dias que mira hacia delante la agenda (npm run agenda).
AGENDA_DIAS=7
# Parecido minimo entre dos titulares para tratarlos como la misma historia.
# Calibrado con titulares reales: con 0,5 se fundian noticias distintas.
GROUP_THRESHOLD=0.6

# --- Watchlist -------------------------------------------------------------
# Ya NO se configura aqui: vive en Neon (tabla `watchlist`), con su umbral por
# valor. Se gestiona con `npm run watchlist -- add NVDA`. WATCHLIST y
# SEC_WATCHLIST siguen valiendo como respaldo si no hay base de datos.

# --- Cadencia (migración 20260910_run_cadence.sql antes de activar) -----------
MONITOR_PROFILE=full
MONITOR_ORIGIN=manual
RUN_TELEMETRY=true
HEALTH_FAST_MINUTES=15
HEALTH_FULL_MINUTES=45
HEALTH_NO_EXECUTION_MINUTES=90
HEALTH_QUEUE_MINUTES=120
HEALTH_RATE_CAPTURE_MINUTES=10
HEALTH_RATE_ALERT_MINUTES=15
HEALTH_NOTICES_ENABLED=false
# El token del reloj va SOLO como secreto de Cloudflare, nunca en este fichero.
