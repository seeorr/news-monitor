# News Monitor — copia este archivo a `.env` y rellena los valores.
# `.env` esta en .gitignore y NUNCA se commitea: el repositorio es publico.
# En produccion estas mismas variables van a GitHub Secrets.

# --- LLM -------------------------------------------------------------------
# console.anthropic.com -> API keys. Requiere credito.
ANTHROPIC_API_KEY=

# --- Macro (columna vertebral del sistema) ---------------------------------
# Gratis e inmediata: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# --- Notificaciones --------------------------------------------------------
# Habla con @BotFather en Telegram -> /newbot -> te da el token.
TELEGRAM_BOT_TOKEN=
# Escribe algo a tu bot y abre:
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# El numero de `chat.id` de tu mensaje es este valor.
TELEGRAM_CHAT_ID=

# Grupo OPCIONAL para compartir noticias con otras personas. Sin esta variable
# nada cambia: no hay segundo destino y el sistema se comporta como siempre.
# Es un id NEGATIVO (p. ej. -1001234567890), no un @nombre: se saca metiendo el
# bot en el grupo, escribiendo algo alli y abriendo el mismo /getUpdates.
#
# AVISO: el grupo recibe EXACTAMENTE lo mismo que el chat privado, sin filtrar.
# Eso incluye los movimientos de precio y los documentos ante la SEC de la
# watchlist, que solo existen porque esos valores estan vigilados. Quien lea el
# grupo puede deducir QUE empresas sigues; no puede deducir CUANTO tienes en
# cada una. Es una decision tomada a proposito, no un descuido.
TELEGRAM_GROUP_CHAT_ID=

# --- Base de datos: Neon Postgres ------------------------------------------
# Decidido: Neon, no Supabase. Ya esta en uso en Finance Hub, el free tier no
# caduca y el proyecto no se pausa mientras el cron lo toque.
# Panel de Neon -> Connection string (pooled). Tras rellenarla: npm run db:migrate
# Sin esto, en GitHub Actions cada ejecucion empieza en blanco y repite la alerta.
DATABASE_URL=

# --- Mercado (bloque 3, opcionales: hay fallback gratuito) -----------------
ALPHA_VANTAGE_API_KEY=
COINGECKO_API_KEY=

# --- SEC EDGAR (tercera fuente) --------------------------------------------
# La SEC exige un contacto real en el User-Agent y responde 403 sin el.
# Formato: "Nombre Apellido correo@dominio". Sin esta variable el ciclo corre
# igual, pero sin documentos regulatorios: se dice por que y se sigue.
SEC_USER_AGENT=
# Tickers cuyos documentos se vigilan, separados por comas: AAPL,NVDA,MSFT
# Dato personal: dice en que inviertes. Nunca en el repositorio, que es publico.
SEC_WATCHLIST=
# Tipos de documento que interesan. Vacio = 8-K, 10-Q, 10-K, 6-K, 20-F y SC 13D.
EDGAR_FORMS=

# --- Filtro y techos del ciclo ---------------------------------------------
# Tickers que, mencionados en un titular, lo hacen pasar el filtro por reglas.
# Tambien es dato personal.
WATCHLIST=
# Feeds que se leen (ids de FEEDS en src/sources/rss.ts). Vacio = todos:
#   fed-press, ecb-press, sec-press, cnbc-markets, yahoo-finance,
#   investing-economy, investing-indicators, investing-stocks
RSS_FEEDS=
# Un titular con mas de estas horas ya no es noticia. Solo aplica a noticias y
# documentos: un dato macro se fecha por su periodo, no por su publicacion.
MAX_ITEM_AGE_HOURS=72
# Techos por ciclo. El cron corre cada 15 minutos y un feed puede soltar treinta
# elementos de golpe: sin techo, el primer dia se dispara la factura.
MAX_SCORING_PER_CYCLE=12
MAX_DEEP_PER_CYCLE=3

# --- Agenda macro y agrupacion ---------------------------------------------
# Dias que mira hacia delante la agenda (npm run agenda).
AGENDA_DIAS=7
# Parecido minimo entre dos titulares para tratarlos como la misma historia.
# Calibrado con titulares reales: con 0,5 se fundian noticias distintas.
GROUP_THRESHOLD=0.6

# --- Watchlist -------------------------------------------------------------
# Ya NO se configura aqui: vive en Neon (tabla `watchlist`), con su umbral por
# valor. Se gestiona con `npm run watchlist -- add NVDA`. WATCHLIST y
# SEC_WATCHLIST siguen valiendo como respaldo si no hay base de datos.
